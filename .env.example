# Локальный порт приложения
PORT=3000

# Обязательный URL подключения к Postgres (Render предоставляет автоматически)
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wishlist

# Для Render автоматически будет production
NODE_ENV=development
